# Copy to .env for local development (netlify dev). Set the same in Netlify > Site settings > Environment variables.
APP_PASSWORD=choose-a-password
SESSION_SECRET=long-random-string
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service-role-key
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for AI import (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: model used for translating imports to Dutch (default claude-haiku-5-5)
# ANTHROPIC_TRANSLATE_MODEL=claude-haiku-5-5
# AI photos (OpenAI image API)
OPENAI_API_KEY=sk-...
# Optional: image model (default gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1
